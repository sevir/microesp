# /etc/systemd/system/microesp-agent.service
[Unit]
Description=MicroESP agent (USB link to the MicroESP dongle)
Documentation=https://github.com/microesp/agent
# The agent discovers and reopens the dongle by itself (backoff 1..30 s),
# so it is not bound to the .device: it stays alive even if the dongle is unplugged.
After=dbus.service systemd-logind.service
Wants=dbus.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/microesp-agent run --config /etc/microesp/agent.toml
User=microesp
# Primary group = the user's (microesp): /etc/microesp is root:microesp
# 0750 and agent.toml 0640. With Group=dialout the process would NOT belong to the
# microesp group and could not read the configuration or the key.
SupplementaryGroups=dialout
Restart=always
RestartSec=3
UMask=0077

# --- Hardening -------------------------------------------------------
# Shutdown/reboot is requested from logind over D-Bus (systemctl/busctl, AF_UNIX)
# and authorized by the polkit rule 50-microesp.rules; no capabilities
# or root are needed.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadOnlyPaths=/
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-ttyACM rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
