{
  "name": "microesp-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Panel MiniApp (Ray) de MicroESP para Smart Life, conectado al modelo TuyaLink",
  "scripts": {
    "start:tuya": "ray start --target=tuya",
    "build:tuya": "ray build --target=tuya",
    "start:ide": "ray start --target=tuya --output dist/tuya-release",
    "build:ide": "ray build --target=tuya --output dist/tuya-release",
    "ide:win-natives": "scripts/add-win-natives.sh",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --no-warnings --test test/*.test.mjs"
  },
  "dependencies": {
    "@ray-js/ray": "1.7.83"
  },
  "devDependencies": {
    "@ray-js/cli": "1.7.83",
    "@types/react": "^17.0.24",
    "@types/react-dom": "^17.0.9",
    "core-js": "^3.23.5",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=22.6"
  }
}
