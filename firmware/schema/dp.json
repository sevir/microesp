{
  "product": "MicroESP",
  "doc": "MicroESP thing model (docs/analysis/00-architecture-analysis.md section 5). Cloud protocol: TuyaLink (ADR-5). 'code' is the TuyaLink property code used on the wire; 'id' is the Tuya abilityId (sequential, as assigned by the platform; kept as the firmware's internal key and in the docs). Must stay in sync with src/core/dp_model.c (checked by test/host).",
  "tuyalink": {
    "topics": {
      "publish": [
        "tylink/<deviceId>/thing/property/report",
        "tylink/<deviceId>/thing/property/set_response",
        "tylink/<deviceId>/thing/action/execute_response",
        "tylink/<deviceId>/thing/model/get"
      ],
      "subscribe": [
        "tylink/<deviceId>/thing/property/set",
        "tylink/<deviceId>/thing/action/execute",
        "tylink/<deviceId>/thing/model/get_response",
        "tylink/<deviceId>/thing/property/report_response"
      ]
    },
    "report": "{\"msgId\":\"<=32 chars\",\"time\":<unix ms>,\"data\":{\"<code>\":{\"value\":V,\"time\":<unix ms>}}}",
    "set": "{\"msgId\":..,\"time\":..,\"data\":{\"<code>\":V,...}} -> property/set_response {\"msgId\":<same>,\"time\":<ms>,\"code\":0|1}",
    "encoding": {
      "bool": "JSON true/false",
      "value": "JSON integer (raw, scale applied by the app)",
      "enum": "JSON string from range",
      "bitmap": "JSON integer bit mask (bit i = label[i])",
      "string": "JSON string"
    }
  },
  "report_policy": {
    "mode": "async from the app task: change thresholds + per-DP throttle; QoS 1, done on PUBACK; every DP force-reported on each MQTT connection",
    "telemetry": "105/106/107 (cpu_usage, mem_usage, disk_free): change >= 20 tenths (min 5 s apart) or any change every 30 s",
    "pc_uptime": "110: at most once per 60 s",
    "rate_limit": "every DP min interval >= 300 ms (<= 200 reports/DP/60 s)"
  },
  "dps": [
    {
      "id": 101,
      "code": "pc_state",
      "type": "enum",
      "mode": "ro",
      "range": [
        "off",
        "sleep",
        "booting",
        "on_no_agent",
        "on",
        "unknown"
      ],
      "source": "dongle"
    },
    {
      "id": 102,
      "code": "power_on",
      "type": "bool",
      "mode": "rw",
      "note": "push button: true triggers wake (method DP 109), dongle reports it back to false",
      "source": "dongle"
    },
    {
      "id": 103,
      "code": "power_off",
      "type": "bool",
      "mode": "rw",
      "note": "true -> shutdown after DP 112 countdown; false while counting cancels; reset to false when finished",
      "source": "agent"
    },
    {
      "id": 104,
      "code": "reboot",
      "type": "bool",
      "mode": "rw",
      "note": "true -> reboot after DP 112 countdown; false while counting cancels; reset to false when finished",
      "source": "agent"
    },
    {
      "id": 105,
      "code": "cpu_usage",
      "type": "value",
      "mode": "ro",
      "min": 0,
      "max": 1000,
      "scale": 1,
      "step": 1,
      "unit": "%",
      "source": "agent"
    },
    {
      "id": 106,
      "code": "mem_usage",
      "type": "value",
      "mode": "ro",
      "min": 0,
      "max": 1000,
      "scale": 1,
      "step": 1,
      "unit": "%",
      "source": "agent"
    },
    {
      "id": 107,
      "code": "disk_free",
      "type": "value",
      "mode": "ro",
      "min": 0,
      "max": 1000,
      "scale": 1,
      "step": 1,
      "unit": "%",
      "source": "agent"
    },
    {
      "id": 108,
      "code": "agent_online",
      "type": "bool",
      "mode": "ro",
      "source": "dongle"
    },
    {
      "id": 109,
      "code": "wake_method",
      "type": "enum",
      "mode": "rw",
      "range": [
        "hid",
        "wol",
        "hid_then_wol"
      ],
      "default": "hid_then_wol",
      "persisted": "NVS",
      "source": "dongle"
    },
    {
      "id": 110,
      "code": "pc_uptime",
      "type": "value",
      "mode": "ro",
      "min": 0,
      "max": 999999999,
      "scale": 0,
      "step": 1,
      "unit": "s",
      "source": "agent"
    },
    {
      "id": 111,
      "code": "pc_hostname",
      "type": "string",
      "mode": "ro",
      "maxlen": 64,
      "source": "agent"
    },
    {
      "id": 112,
      "code": "cmd_countdown",
      "type": "value",
      "mode": "rw",
      "min": 0,
      "max": 60,
      "scale": 0,
      "step": 1,
      "unit": "s",
      "default": 10,
      "persisted": "NVS",
      "source": "dongle"
    },
    {
      "id": 113,
      "code": "last_result",
      "type": "enum",
      "mode": "ro",
      "range": [
        "ok",
        "wake_sent",
        "wake_failed",
        "cmd_rejected",
        "agent_offline",
        "cancelled"
      ],
      "source": "dongle"
    },
    {
      "id": 114,
      "code": "fault",
      "type": "bitmap",
      "mode": "ro",
      "label": [
        "agent_lost",
        "wake_failed",
        "hid_not_armed",
        "cloud_lost"
      ],
      "maxlen": 4,
      "source": "dongle"
    },
    {
      "id": 115,
      "code": "scripts",
      "type": "string",
      "mode": "ro",
      "maxlen": 255,
      "note": "user scripts reported by the agent (cdc-v1 §3.1) as compact JSON [[\"<id>\",\"<label>\"],...], 0..5 items, at most 221 bytes; not reported until the agent sends its list",
      "source": "agent"
    },
    {
      "id": 116,
      "code": "script_run",
      "type": "string",
      "mode": "rw",
      "maxlen": 12,
      "note": "push button: '<id>' of a script in DP 115 -> cmd script:<id> to the agent (result in DP 113: ok / cmd_rejected / agent_offline); dongle reports it back to ''",
      "source": "dongle"
    }
  ]
}
