/*
 * Tuya credentials for MicroESP. Copy to include/tuya_secrets.h (gitignored) and fill in:
 *   cp include/tuya_secrets.h.example include/tuya_secrets.h
 * Values stored at runtime with the CDC CLI ("!auth <uuid> <authkey>", "!pid <pid>")
 * live in NVS and take precedence over this header. Without either, placeholder
 * values are used: the firmware compiles and boots but never reaches the cloud.
 */
#pragma once

#define TUYA_PRODUCT_ID      "xxxxxxxxxxxxxxxx"                 /* PID of the custom MicroESP product */
#define TUYA_OPENSDK_UUID    "uuidxxxxxxxxxxxxxxxx"             /* TuyaOpen license UUID */
#define TUYA_OPENSDK_AUTHKEY "keyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" /* TuyaOpen license AuthKey */
