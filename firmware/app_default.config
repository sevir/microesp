CONFIG_PROJECT_NAME="microesp"
# Firmware version: SINGLE source (Tuya OTA, cdc-v1 welcome, display, !version)
CONFIG_PROJECT_VERSION="0.4.2"
CONFIG_BOARD_CHOICE_ESP32=y
CONFIG_BOARD_CHOICE_POCKET_DONGLE_S3=y
# LVGL v9 (display)
CONFIG_ENABLE_LIBLVGL=y
CONFIG_LVGL_VERSION_9=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y
